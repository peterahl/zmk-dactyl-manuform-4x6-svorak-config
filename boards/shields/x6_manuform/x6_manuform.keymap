// Svorak keymap for Dactyl Manuform (52 keys total: 26 per half)
// 3 main rows x 6 cols + 2 bottom finger keys + 6 thumb keys per half
// Layer 0: Bokstäver (Svorak layout)
// Layer 1: Symboler
// Layer 2: Siffror, Navigation & System (USB/BLE)

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#define DEFAULT 0
#define SYMBOLS 1
#define NUMBERS 2

/* Svorak svensk teckenmappning (när OS är inställt på svensk layout) */
#define SV_AA  &kp LBKT   // Å / å
#define SV_AE  &kp SCLN   // Ä / ä
#define SV_OE  &kp SQT    // Ö / ö

/ {
    keymap {
        compatible = "zmk,keymap";

        // Layer 0: Bokstäver (Svorak)
        default_layer {
            bindings = <
                &kp TAB    SV_AA      SV_AE      SV_OE      &kp P      &kp Y               &kp F      &kp G      &kp C      &kp R      &kp L      &kp BSPC
                &kp LCTRL  &kp A      &kp O      &kp E      &kp U      &kp I               &kp D      &kp H      &kp T      &kp N      &kp S      &kp MINUS
                &kp LSHFT  &kp COMMA  &kp DOT    &kp J      &kp K      &kp X               &kp B      &kp M      &kp W      &kp V      &kp Z      &kp RSHFT
                                      &kp LEFT   &kp DOWN                                                       &kp UP     &kp RIGHT
                &kp BSPC   &kp DEL    &kp ESC    &mo SYMBOLS &mo NUMBERS &kp LALT          &mo NUMBERS &mo SYMBOLS &kp RCTRL &kp SPACE  &kp RET    &kp TAB
            >;
        };

        // Layer 1: Symboler
        symbols_layer {
            bindings = <
                &kp GRAVE  &kp EXCL   &kp AT     &kp HASH   &kp DLLR   &kp PRCNT           &kp CARET  &kp AMPS   &kp ASTRK  &kp LPAR   &kp RPAR   &kp DEL
                &trans     &kp LBRC   &kp RBRC   &kp LPAR   &kp RPAR   &kp AMPS            &kp MINUS  &kp EQUAL  &kp COLON  &kp SEMI   &kp SQT    &kp DQT
                &trans     &kp LBKT   &kp RBKT   &kp LT     &kp GT     &kp PIPE            &kp BSLH   &kp PLUS   &kp COMMA  &kp DOT    &kp SLASH  &trans
                                      &kp HOME   &kp END                                                        &kp PG_UP  &kp PG_DN
                &trans     &trans     &trans     &trans     &trans     &trans              &trans     &trans     &trans     &kp SPACE  &kp RET    &trans
            >;
        };

        // Layer 2: Siffror, Navigation & System (USB/BLE utskrift)
        numbers_layer {
            bindings = <
                &kp ESC       &kp F1        &kp F2        &kp F3        &kp F4        &kp F5              &kp N7     &kp N8     &kp N9     &kp PLUS   &kp MINUS  &kp BSPC
                &trans        &kp F6        &kp F7        &kp F8        &kp F9        &kp F10             &kp N4     &kp N5     &kp N6     &kp ASTRK  &kp SLASH  &kp RET
                &out OUT_USB  &out OUT_BLE  &out OUT_TOG  &bt BT_CLR    &bt BT_SEL 0  &bt BT_SEL 1        &kp N1     &kp N2     &kp N3     &kp EQUAL  &kp DOT    &trans
                                            &kp LEFT      &kp DOWN                                                              &kp UP     &kp RIGHT
                &trans        &trans        &trans        &trans        &trans        &trans              &trans     &trans     &trans     &kp N0     &kp DOT    &trans
            >;
        };
    };
};
